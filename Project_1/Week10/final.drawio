<mxCell id="exc_title" value="Exceptions (finance_exceptions package)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1520" width="500" height="30" as="geometry" /></mxCell>
<mxCell id="raises_note" value="&lt;b&gt;Where each error is raised and handled&lt;/b&gt;&lt;br&gt;Account.check_amount (used by deposit and withdrawal): InvalidAmountError&lt;br&gt;Account.withdrawal: InsufficientFundsError&lt;br&gt;SavingsAccount.withdrawal: MinimumBalanceError&lt;br&gt;EverydayAccount.withdrawal: WithdrawalLimitError&lt;br&gt;Client.get_account: AccountNotFoundError&lt;br&gt;Transaction.process_transaction: TransactionStatusError&lt;br&gt;&lt;br&gt;Client.remove_account and Client.process_transaction catch AccountNotFoundError.&lt;br&gt;Transaction.process_transaction catches FinanceError, reports it and returns False.&lt;br&gt;&lt;br&gt;Branch, Client, Account, SavingsAccount and Transaction use the validation module to check their input." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1580" width="720" height="250" as="geometry" /></mxCell>
